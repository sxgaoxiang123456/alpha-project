# ============================================================
# A股自动盯盘AI助手 · 环境变量配置示例
# 复制本文件为 .env 后填写实际值，敏感信息勿提交到版本控制
# ============================================================

# -----------------------------------------------------------
# 1. 飞书推送通道（主通道）
# -----------------------------------------------------------
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BRAND=
FEISHU_CHAT_ID=

# -----------------------------------------------------------
# 2. Telegram 推送通道（备用通道，可选）
# -----------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_PROXY=

# -----------------------------------------------------------
# 3. LLM 配置（v1.1 F7/F8 需要）
# -----------------------------------------------------------
# DeepSeek API Key，用于 AI 早盘简报和自然语言设预警
# 获取方式：https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_RETRY_ATTEMPTS=3
DEEPSEEK_RETRY_INTERVAL_SECONDS=5

# -----------------------------------------------------------
# 4. 配置加密密钥（必须）
# -----------------------------------------------------------
# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=

# -----------------------------------------------------------
# 5. 数据源配置（默认值通常足够，按需调整）
# -----------------------------------------------------------
DATASOURCE_PRIMARY_TIMEOUT=10
DATASOURCE_FALLBACK_TIMEOUT=15
DATASOURCE_RETRY_COUNT=2
HEALTH_CHECK_INTERVAL=300

# -----------------------------------------------------------
# 6. 行情刷新配置（默认值通常足够，按需调整）
# -----------------------------------------------------------
QUOTE_REFRESH_INTERVAL=180
QUOTE_CACHE_TTL=300

# -----------------------------------------------------------
# 7. 系统配置
# -----------------------------------------------------------
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/watchlist.db
